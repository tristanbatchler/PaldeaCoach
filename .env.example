# Copy to .env and point POKEMON_SAVE at your Scarlet/Violet save file (the file is called "main").
# Eden (Flatpak):  ~/.var/app/dev.eden_emu.eden/data/eden/nand/user/save/0000000000000000/<profile id>/0100A3D008C5C000/main
# Eden (native):   ~/.local/share/eden/nand/user/save/0000000000000000/<profile id>/0100A3D008C5C000/main
# Scarlet is 0100A3D008C5C000, Violet is 01008F6008C5E000.
POKEMON_SAVE="$HOME/path/to/main"
